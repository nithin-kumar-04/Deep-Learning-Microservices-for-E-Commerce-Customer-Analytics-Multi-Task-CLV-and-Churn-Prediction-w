# Copy this file to .env and adjust for your environment.
# Never commit the real .env file.

# --- API ---
# Shared secret required in the X-API-Key header for protected endpoints.
API_KEY=default-secret-key
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:3000
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: download model/data artifacts from S3 when missing locally.
S3_BUCKET_NAME=

# --- Frontend (also used as Docker build args) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=default-secret-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
